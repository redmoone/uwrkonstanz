# Local SQLite database. The folder is mounted persistently in Docker.
DATABASE_URL=file:./data/uwr.db

# Generate e.g. with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-long-random-secret

# Local development URL. Change to https://uwr-konstanz.de in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
