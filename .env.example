# Local SQLite database. The folder is mounted persistently in Docker.
DATABASE_URL=file:./data/uwr.db

# Generate e.g. with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-long-random-secret

# Local development URL. Change to https://uwr-konstanz.de in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Direct contact-form delivery. Configure these on the server; never commit credentials.
SMTP_HOST=
SMTP_PORT=587
# Leave empty to infer TLS from the port (465 = implicit TLS, 587 = STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Optional override for the CMS contact address; empty sends to CMS settings / active trainers.
CONTACT_TO_EMAIL=
